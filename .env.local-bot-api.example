# Telegram bot token from BotFather.
TG_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Telegram developer credentials from https://my.telegram.org
# Required by the local telegram-bot-api server.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH

# Kodi connection settings.
KODI_HOST=172.17.0.1
KODI_PORT=8080
KODI_WS_PORT=9090
KODI_USER=USER
KODI_PASS=Password

# Optional device / integration settings.
CEC_HOST=172.17.0.1
DENON_HOST=DENON_IP
DEBUG_WS=1
SC_CLIENT_ID=YOUR_CLIENT_ID
HA_HOST=YOUR_HOMEASSISTANT_IP
HA_PORT=8123
HA_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN
HA_LIGHT_ID=light.living_room
# Saved HA colors are persisted via docker-compose under:
# /storage/docker/partyqueue/colors -> /data/colors/ha_colors.json

# TV (IPTV) Stream settings.
# Supports multiple comma-separated M3U URLs (e.g. Kodinerds and iptv-org lists).
IPTV_M3U_URL=https://raw.githubusercontent.com/jnk22/kodinerds-iptv/master/iptv/clean/kodi_tv.m3u,https://iptv-org.github.io/iptv/countries/de.m3u

# Radio Browser API source (community-driven global radio database).
# You can change this to any other official mirror if needed.
RADIO_API_URL=https://de1.api.radio-browser.info/json

WEBAPP_HOSTNAME=bot.example.com
ACME_EMAIL=you@example.com
HA_WEBAPP_URL=https://bot.example.com/app/ha-color
# If docker compose is started from a different directory, set the absolute
# path to the Caddyfile on the host.
CADDYFILE_PATH=/storage/docker/partyqueue/vOpus/Caddyfile

# URL under which Kodi can reach the bot's temporary media server.
# This is for Kodi playback and may stay a local HTTP address.
MEDIA_BASE_URL=http://YOUR_HOST_IP:8765
UI_STATE_FILE=/data/state/telegram_ui_state.json

# Telegram API request timeouts in seconds.
# Usually you can leave these as-is.
# If very large Telegram uploads ever fail with "Timed out",
# increase TELEGRAM_READ_TIMEOUT and TELEGRAM_GET_FILE_READ_TIMEOUT.
# Max time to wait for a normal Telegram API response body.
TELEGRAM_READ_TIMEOUT=900
# Max time to wait while sending a normal Telegram API request.
TELEGRAM_WRITE_TIMEOUT=30
# Max time to establish a TCP connection to the Telegram API endpoint.
TELEGRAM_CONNECT_TIMEOUT=30
# Max time to wait for a free HTTP connection from the internal request pool.
TELEGRAM_POOL_TIMEOUT=30
# Max time to wait for the get_file Telegram API response body.
TELEGRAM_GET_FILE_READ_TIMEOUT=900
# Max time to wait while sending the get_file request itself.
TELEGRAM_GET_FILE_WRITE_TIMEOUT=30
# Max time to establish a TCP connection for the get_file request.
TELEGRAM_GET_FILE_CONNECT_TIMEOUT=30
# Max time to wait for a free pooled HTTP connection for get_file.
TELEGRAM_GET_FILE_POOL_TIMEOUT=30

# Telegram UI language: en or de.
BOT_LANGUAGE=en

# Projector (Beamer) infrared controls via pigpio
PROJECTOR_ADDRESS=0x08
PROJECTOR_POWER_ON_CODE=0x03
PROJECTOR_POWER_OFF_CODE=0x00
PROJECTOR_POWER_ON_REPEATS=4

# ── Display power (projector or TV) ──────────────────────────────
DISPLAY_BUTTON_LABEL=📽 Beamer
DISPLAY_POWER_ON_CMD=python -m kodibot.core.projector on
DISPLAY_POWER_OFF_CMD=python -m kodibot.core.projector off
DISPLAY_COMMAND_TIMEOUT=15
TV_HOST=
PROJECTOR_LIRC_DEVICE=/dev/lirc0

# ── Optional panel buttons (all default to true) ─────────────────
PANEL_SHOW_VOLUME=true
PANEL_SHOW_HIFI=true
PANEL_SHOW_DISPLAY=true
PANEL_SHOW_AIRPLAY=true
PANEL_SHOW_HA=true

# Spotify (optional) - no account or credentials needed; see README section "Spotify links"
SPOTIFY_MAX_TRACKS=100
SPOTIFY_YT_TIMEOUT=25
SPOTIFY_TIMEOUT=10
